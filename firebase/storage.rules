rules_version = '2';

// Report photos live at reports/{uid}/{reportId}/{photo}.jpg; Burghood
// society claim files, documents and notice attachments below them.
service firebase.storage {
  match /b/{bucket}/o {
    function isPlatformAdmin() {
      return request.auth != null
        && request.auth.token.get('platformAdmin', false) == true;
    }

    // The caller is an approved member of society [sid] with one of
    // [roles], per the Firestore member doc.
    function hasRole(sid, roles) {
      let path = /databases/(default)/documents/societies/$(sid)/members/$(request.auth.uid);
      return request.auth != null && firestore.exists(path)
        && firestore.get(path).data.status == 'approved'
        && firestore.get(path).data.role in roles;
    }

    function isMember(sid) {
      return hasRole(sid, ['member', 'committee', 'admin']);
    }

    function canSeeRequest(rid) {
      let path = /databases/(default)/documents/serviceRequests/$(rid);
      return isPlatformAdmin() || (request.auth != null && firestore.exists(path)
        && (firestore.get(path).data.posterUid == request.auth.uid
            || firestore.get(path).data.get('providerId', '') == request.auth.uid));
    }

    match /reports/{uid}/{reportId}/{file} {
      // Photos are public once uploaded (blurred in Phase 2).
      allow read: if true;

      // Write once, by the owner, JPEG only, max 2 MB.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 2 * 1024 * 1024
        && file.matches('[0-9a-f-]+(_thumb)?\\.jpg');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Burghood society claims: photo ID and proof of office, at
    // societyClaims/{uid}/{claimId}/{id|proof}.{jpg|png|pdf}. The applicant
    // uploads them once; only platform admins can read them, and the
    // purgeClaimFiles function deletes them 30 days after the decision.
    match /societyClaims/{uid}/{claimId}/{file} {
      allow read: if isPlatformAdmin();
      // Write once: resource is the existing file, if any.
      allow create: if resource == null
        && request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && file.matches('(id|proof)[.](jpg|png|pdf)')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'application/pdf']
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Society documents (PDF) and notice attachments, for approved members.
    match /societies/{sid}/documents/{file} {
      allow read: if isMember(sid) || isPlatformAdmin();
      allow create: if hasRole(sid, ['admin'])
        && file.matches('[A-Za-z0-9_-]+[.]pdf')
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if hasRole(sid, ['admin']);
    }

    // Channel post photos (Phase 2): members upload JPEGs into a post's
    // folder; the onPostDeleted function removes them with the post.
    match /societies/{sid}/posts/{postId}/{file} {
      allow read: if isMember(sid) || isPlatformAdmin();
      allow create: if resource == null && isMember(sid)
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 2 * 1024 * 1024
        && file.matches('[0-9a-f-]+(_thumb)?[.]jpg');
    }

    // Provider licence, insurance and background-check documents (Phase 3):
    // written once by the applicant, read only by platform admins.
    match /providerDocs/{uid}/{file} {
      allow read: if isPlatformAdmin();
      allow create: if resource == null
        && request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && file.matches('(license|insurance|background)[.](jpg|png|pdf)')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'application/pdf']
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Photos of past jobs on a provider's public profile.
    match /providers/{uid}/portfolio/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Service request photos from the poster, and completion photos or a
    // short video from the assigned provider. Both, and platform admins,
    // can see them.
    match /serviceRequests/{rid}/{file} {
      allow read: if canSeeRequest(rid);
      allow create: if resource == null && request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 2 * 1024 * 1024
        // Uploaded before the request exists, or by its poster.
        && (!firestore.exists(/databases/(default)/documents/serviceRequests/$(rid))
            || firestore.get(/databases/(default)/documents/serviceRequests/$(rid)).data.posterUid == request.auth.uid);
    }

    match /serviceRequests/{rid}/completion/{file} {
      allow read: if canSeeRequest(rid);
      allow create: if resource == null && request.auth != null
        && firestore.get(/databases/(default)/documents/serviceRequests/$(rid)).data.get('providerId', '') == request.auth.uid
        && (request.resource.contentType == 'image/jpeg' && request.resource.size < 2 * 1024 * 1024
            || request.resource.contentType == 'video/mp4' && request.resource.size < 30 * 1024 * 1024);
    }

    match /societies/{sid}/notices/{noticeId}/{file} {
      allow read: if isMember(sid) || isPlatformAdmin();
      allow create: if hasRole(sid, ['admin', 'committee'])
        && request.resource.contentType in ['application/pdf', 'image/jpeg']
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if hasRole(sid, ['admin', 'committee']);
    }
  }
}

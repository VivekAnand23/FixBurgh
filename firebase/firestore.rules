rules_version = '2';

// FixBurgh Firestore rules (BRD section 14.3). Deny by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Email accounts must verify their address before voting (BRD 9.1).
    function canVote() {
      return signedIn()
        && (request.auth.token.firebase.sign_in_provider != 'password'
            || request.auth.token.email_verified == true);
    }

    // Burghood platform staff, set by functions/scripts/set-platform-admin.js.
    function isPlatformAdmin() {
      return signedIn() && request.auth.token.get('platformAdmin', false) == true;
    }

    function isModerator() {
      return signedIn() && request.auth.token.get('role', '') in ['moderator', 'admin'];
    }

    // Allegheny County bounding box, with a small margin.
    function inCounty(g) {
      return g.lat is number && g.lng is number
        && g.lat > 40.18 && g.lat < 40.68
        && g.lng > -80.37 && g.lng < -79.68;
    }

    function validNewReport(d) {
      return d.keys().hasOnly([
          'authorUid', 'authorIsGuest', 'category', 'severity', 'description',
          'geo', 'address', 'municipalityId', 'municipalityName', 'photos',
          'status', 'upvoteCount', 'flagCount', 'moderation',
          'agencyId', 'agencyName', 'roadOwner', 'roadName', 'stateRoute',
          'source', 'createdAt', 'updatedAt'])
        && d.get('source', 'online') in ['online', 'offline_queue']
        && d.authorUid == request.auth.uid
        && d.authorIsGuest == (request.auth.token.firebase.sign_in_provider == 'anonymous')
        && d.category in ['pothole', 'landslide', 'flooding', 'streetlight',
                          'dumping', 'fallen_tree', 'sidewalk', 'other']
        && d.severity in ['low', 'medium', 'urgent']
        && d.description is string && d.description.size() <= 280
        && d.geo is map && inCounty(d.geo)
        && d.geo.geohash is string && d.geo.geohash.size() == 9
        && d.municipalityId is string && d.municipalityName is string
        && d.photos is list && d.photos.size() >= 1 && d.photos.size() <= 3
        && d.status == 'reported'
        && d.upvoteCount == 0 && d.flagCount == 0
        && d.moderation == 'visible'
        && d.createdAt == request.time && d.updatedAt == request.time;
    }

    match /reports/{reportId} {
      allow read: if resource.data.moderation == 'visible'
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || isModerator();

      allow create: if signedIn() && validNewReport(request.resource.data)
        && withinDailyLimit();

      // Authors can change status and description, and add an "after"
      // photo when they mark it fixed.
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'description', 'resolvedAt', 'resolvedBy',
                       'sentAt', 'contactChannel', 'afterPhoto', 'updatedAt'])
        && validAfterPhoto(request.resource.data.get('afterPhoto', null))
        && request.resource.data.status in ['reported', 'sent', 'resolved']
        && request.resource.data.description.size() <= 280
        && request.resource.data.updatedAt == request.time;

      // Anyone signed in can "Me too" once, paired with their upvote doc,
      // up to 30 a day (BRD FR-MOD-06).
      allow update: if canVote()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['upvoteCount'])
        && voteChanged('upvotes', 'upvoteCount', reportId)
        && (request.resource.data.upvoteCount < resource.data.upvoteCount
            || withinVoteLimit());

      // "Looks fixed" votes; the vote that reaches 3 resolves the report.
      allow update: if signedIn()
        && voteChanged('fixedVotes', 'fixedVoteCount', reportId)
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fixedVoteCount'])
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['fixedVoteCount', 'status', 'resolvedBy', 'resolvedAt'])
              && request.resource.data.fixedVoteCount >= 3
              && request.resource.data.status == 'resolved'
              && request.resource.data.resolvedBy == 'community'
              && request.resource.data.resolvedAt == request.time)
        );

      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      match /upvotes/{uid} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == uid && validVote();
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /fixedVotes/{uid} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == uid && validVote();
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Status history, written only by the onReportWritten function.
      match /events/{eventId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // `uid` lets account deletion find a person's votes.
    function validVote() {
      return request.resource.data.keys().hasOnly(['createdAt', 'uid'])
        && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
    }

    // An "after" photo the author uploaded under their own folder.
    function validAfterPhoto(p) {
      return p == null || (p is map
        && p.keys().hasOnly(['path', 'thumbPath', 'thumbUrl'])
        && p.path is string && p.thumbPath is string && p.thumbUrl is string
        && p.path.matches('reports/' + request.auth.uid + '/.*')
        && p.thumbPath.matches('reports/' + request.auth.uid + '/.*'));
    }

    // A count moves by exactly one, together with the caller's vote doc.
    function voteChanged(coll, field, rid) {
      let path = /databases/$(database)/documents/reports/$(rid)/$(coll)/$(request.auth.uid);
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return (after == before + 1 && !exists(path) && existsAfter(path))
          || (after == before - 1 && exists(path) && !existsAfter(path));
    }

    // One flag per person per report: the doc id is "<reportId>_<uid>".
    match /flags/{flagId} {
      allow create: if signedIn()
        && flagId == request.resource.data.reportId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['reportId', 'reporterUid', 'reason', 'note', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['spam', 'offensive', 'private_info',
             'wrong_location', 'wrong_category', 'wrong_routing']
        && request.resource.data.get('note', '').size() <= 280
        && request.resource.data.createdAt == request.time;
      allow read: if isModerator();
    }

    // Read-only directory data, edited by admins in the console.
    match /agencies/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /municipalities/{id} {
      allow read: if true;
      allow write: if false;
    }
    // `config/directory.version` changes when an agency record does.
    match /config/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Daily report limits (BRD FR-MOD-06): each new report must bump the
    // caller's counter for today by exactly one in the same batch.
    function today() {
      return string(request.time.year()) + '-' + string(request.time.month())
        + '-' + string(request.time.day());
    }

    function dailyLimit() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous' ? 3 : 10;
    }

    function withinDailyLimit() {
      return withinLimit('rateLimits', dailyLimit());
    }

    function withinVoteLimit() {
      return withinLimit('voteLimits', 30);
    }

    // The caller's counter in `coll` moved up by one for today in this
    // same write, and is still within [max].
    function withinLimit(coll, max) {
      let path = /databases/$(database)/documents/$(coll)/$(request.auth.uid);
      let after = getAfter(path).data;
      let before = exists(path) ? get(path).data : {'day': '', 'count': 0};
      return after.day == today()
        && after.count == (before.day == today() ? before.count + 1 : 1)
        && after.count <= max;
    }

    // Counters only ever go up by one per write, and reset each day, so
    // they can't be wound back to dodge the limit.
    function validCounter(max) {
      let prev = resource == null ? {'day': '', 'count': 0} : resource.data;
      return request.resource.data.keys().hasOnly(['day', 'count'])
        && request.resource.data.day == today()
        && request.resource.data.count
             == (prev.day == today() ? prev.count + 1 : 1)
        && request.resource.data.count <= max;
    }

    match /rateLimits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && validCounter(dailyLimit());
    }

    match /voteLimits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && validCounter(30);
    }

    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['role'])
        && unchangedField('societyIds')
        && validNotifySettings(request.resource.data);

      // Push tokens, one per device (BRD FR-NTF-02).
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() < 4096
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.updatedAt == request.time;
      }

      // Up to 3 saved places, stored as coordinates and geohash only
      // (BRD FR-NTF-03).
      match /places/{placeId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && placeId in ['p1', 'p2', 'p3']
          && validPlace(request.resource.data);
      }

      // Notifications sent, written only by Cloud Functions.
      match /notifications/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Notification choices and quiet hours (BRD FR-NTF-05).
    function validNotifySettings(d) {
      return (!('notify' in d) || (d.notify is map
          && d.notify.keys().hasOnly(['status', 'nearby', 'notices', 'interactions', 'mentions', 'services'])
          && d.notify.get('services', true) is bool
          && d.notify.get('interactions', true) is bool
          && d.notify.get('mentions', true) is bool
          && d.notify.get('status', true) is bool
          && d.notify.get('nearby', true) is bool
          && d.notify.get('notices', true) is bool))
        && (!('quietHours' in d) || (d.quietHours is map
          && d.quietHours.keys().hasOnly(['enabled', 'start', 'end'])
          && d.quietHours.enabled is bool
          && d.quietHours.start is int && d.quietHours.start >= 0 && d.quietHours.start < 1440
          && d.quietHours.end is int && d.quietHours.end >= 0 && d.quietHours.end < 1440))
        && (!('utcOffsetMinutes' in d) || (d.utcOffsetMinutes is int
          && d.utcOffsetMinutes >= -840 && d.utcOffsetMinutes <= 840));
    }

    // [field] is left as it was (absent stays absent). For fields only Cloud
    // Functions write, like users.societyIds.
    function unchangedField(field) {
      return resource == null
        ? !(field in request.resource.data)
        : request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function validPlace(p) {
      return p.keys().hasOnly(['kind', 'label', 'lat', 'lng', 'geohash', 'radiusMiles', 'updatedAt'])
        && p.kind in ['home', 'school', 'work', 'other']
        && p.get('label', '') is string && p.get('label', '').size() <= 40
        && p.lat is number && p.lat >= -90 && p.lat <= 90
        && p.lng is number && p.lng >= -180 && p.lng <= 180
        && p.geohash is string && p.geohash.size() == 9
        && p.radiusMiles is number && p.radiusMiles >= 0.25 && p.radiusMiles <= 2
        && p.updatedAt == request.time;
    }

    // ---- Burghood societies (Phase 1) ----

    function fullAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function memberPath(sid, uid) {
      return /databases/$(database)/documents/societies/$(sid)/members/$(uid);
    }

    // The caller's approved membership of [sid] has one of [roles].
    function hasRole(sid, roles) {
      let path = memberPath(sid, request.auth.uid);
      return signedIn() && exists(path)
        && get(path).data.status == 'approved'
        && get(path).data.role in roles;
    }

    function isMember(sid) {
      return hasRole(sid, ['member', 'committee', 'admin']);
    }

    function isSocietyAdmin(sid) {
      return hasRole(sid, ['admin']);
    }

    function canPostNotices(sid) {
      return hasRole(sid, ['committee', 'admin']);
    }

    function httpsUrl(u) {
      return u is string && u.size() <= 500 && (u == '' || u.matches('https://.+'));
    }

    // Created only by the decideClaim function once a platform admin has
    // checked the claim. Active societies are listed in search for anyone
    // with an account; everything inside one is for its members.
    match /societies/{sid} {
      allow read: if (fullAccount() && resource.data.status == 'active')
        || isMember(sid) || isPlatformAdmin();
      allow write: if false;

      match /members/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid)
          || isMember(sid) || isPlatformAdmin();

        // Asking to join: pending, as an ordinary member.
        allow create: if fullAccount() && request.auth.uid == uid
          && get(/databases/$(database)/documents/societies/$(sid)).data.status == 'active'
          && request.resource.data.keys().hasOnly(
               ['uid', 'unit', 'displayName', 'role', 'status', 'requestedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.unit is string
          && request.resource.data.unit.size() > 0 && request.resource.data.unit.size() <= 20
          && request.resource.data.get('displayName', '') is string
          && request.resource.data.get('displayName', '').size() <= 60
          && request.resource.data.role == 'member'
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time;

        // Admins decide requests, change roles and remove members, but
        // not their own membership, so a society always keeps an admin.
        allow update: if isSocietyAdmin(sid) && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'role', 'decidedAt', 'decidedBy'])
          && request.resource.data.status in ['pending', 'approved', 'declined', 'removed']
          && request.resource.data.role in ['member', 'committee', 'admin']
          && request.resource.data.decidedBy == request.auth.uid
          && request.resource.data.decidedAt == request.time;

        // Leaving, or withdrawing a request. Admins hand over first.
        allow delete: if signedIn() && request.auth.uid == uid
          && resource.data.role != 'admin';

        // Members keep their own channel read times and mutes (Phase 2).
        allow update: if signedIn() && request.auth.uid == uid
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastRead', 'mutes'])
          && request.resource.data.get('lastRead', {}) is map
          && request.resource.data.get('lastRead', {}).size() <= 100
          && request.resource.data.get('mutes', {}) is map
          && request.resource.data.get('mutes', {}).size() <= 100;
      }

      // Reported posts and comments, for the society's admins and
      // committee. One per person per item: "<postId>_<commentId>_<uid>".
      match /flags/{flagId} {
        allow read, delete: if canPostNotices(sid);
        allow create: if isMember(sid)
          && request.resource.data.keys().hasOnly(
               ['channelId', 'postId', 'commentId', 'reporterUid', 'reason', 'createdAt'])
          && request.resource.data.reporterUid == request.auth.uid
          && flagId == request.resource.data.postId + '_'
               + request.resource.data.get('commentId', '') + '_' + request.auth.uid
          && request.resource.data.reason in ['spam', 'offensive', 'private_info', 'other']
          && request.resource.data.createdAt == request.time;
      }

      // Providers the society's admins recommend to members (Phase 3).
      match /recommended/{providerId} {
        allow read: if isMember(sid);
        allow create, update: if isSocietyAdmin(sid)
          && request.resource.data.keys().hasOnly(['by', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
        allow delete: if isSocietyAdmin(sid);
      }

      // Reaction digests, kept by Cloud Functions to bundle pushes.
      match /digests/{digestId} {
        allow read, write: if false;
      }

      match /notices/{noticeId} {
        allow read: if isMember(sid) || isPlatformAdmin();
        allow create: if canPostNotices(sid)
          && validNotice(sid, noticeId, request.resource.data)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if (isSocietyAdmin(sid)
            || (canPostNotices(sid) && resource.data.authorUid == request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'body', 'pinned', 'expiresAt', 'attachment', 'updatedAt'])
          && validNotice(sid, noticeId, request.resource.data)
          && request.resource.data.updatedAt == request.time;
        allow delete: if isSocietyAdmin(sid)
          || (canPostNotices(sid) && resource.data.authorUid == request.auth.uid);
      }

      match /documents/{docId} {
        allow read: if isMember(sid) || isPlatformAdmin();
        allow create: if isSocietyAdmin(sid)
          && request.resource.data.keys().hasOnly(
               ['title', 'category', 'path', 'fileName', 'sizeBytes', 'uploadedBy', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && request.resource.data.category in ['bylaws', 'minutes', 'budget', 'rules', 'other']
          && request.resource.data.path == 'societies/' + sid + '/documents/' + docId + '.pdf'
          && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 200
          && request.resource.data.sizeBytes is int
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if isSocietyAdmin(sid);
      }

      // HOA management company and the one account-section link. Links
      // only; no balances or payment details.
      match /hoa/{docId} {
        allow read: if isMember(sid) || isPlatformAdmin();
        allow write: if isSocietyAdmin(sid) && docId == 'info'
          && request.resource.data.keys().hasOnly(['company', 'website', 'accountUrl', 'updatedAt'])
          && request.resource.data.company is string && request.resource.data.company.size() <= 100
          && httpsUrl(request.resource.data.website)
          && httpsUrl(request.resource.data.accountUrl)
          && request.resource.data.updatedAt == request.time;
      }

      // The current invite code, set by the regenerateInviteCode function.
      match /private/{docId} {
        allow read: if isSocietyAdmin(sid);
        allow write: if false;
      }

      // Community channels (Phase 2). General is created by Cloud
      // Functions and can't be archived; admins add, rename and archive
      // the rest. Counts and the last-post preview are kept by functions.
      match /channels/{channelId} {
        allow read: if isMember(sid) || isPlatformAdmin();
        allow create: if isSocietyAdmin(sid) && channelId != 'general'
          && request.resource.data.keys().hasOnly(['name', 'createdBy', 'archived', 'createdAt'])
          && validChannelName(request.resource.data.name)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.archived == false
          && request.resource.data.createdAt == request.time;
        allow update: if isSocietyAdmin(sid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'archived', 'updatedAt'])
          && validChannelName(request.resource.data.name)
          && request.resource.data.archived is bool
          && (channelId != 'general' || request.resource.data.archived == false)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;

        match /posts/{postId} {
          allow read: if isMember(sid) || isPlatformAdmin();
          allow create: if isMember(sid)
            && channelOpen(sid, channelId)
            && validPost(sid, postId, request.resource.data)
            && request.resource.data.createdAt == request.time;
          // Authors edit their text; admins and committee pin.
          allow update: if (isMember(sid)
              && resource.data.authorUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['text', 'mentions', 'editedAt'])
              && validPost(sid, postId, request.resource.data)
              && request.resource.data.editedAt == request.time)
            || (canPostNotices(sid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
              && request.resource.data.pinned is bool);
          allow delete: if (isMember(sid) && resource.data.authorUid == request.auth.uid)
            || canPostNotices(sid);

          match /comments/{commentId} {
            allow read: if isMember(sid) || isPlatformAdmin();
            allow create: if isMember(sid)
              && channelOpen(sid, channelId)
              && validComment(request.resource.data)
              && request.resource.data.createdAt == request.time;
            allow update: if isMember(sid)
              && resource.data.authorUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['text', 'mentions', 'editedAt'])
              && validComment(request.resource.data)
              && request.resource.data.editedAt == request.time;
            allow delete: if (isMember(sid) && resource.data.authorUid == request.auth.uid)
              || canPostNotices(sid);

            match /reactions/{uid} {
              allow read: if isMember(sid);
              allow create, update: if isMember(sid) && request.auth.uid == uid
                && validReaction(request.resource.data);
              allow delete: if isMember(sid) && request.auth.uid == uid;
            }
          }

          match /reactions/{uid} {
            allow read: if isMember(sid);
            allow create, update: if isMember(sid) && request.auth.uid == uid
              && validReaction(request.resource.data);
            allow delete: if isMember(sid) && request.auth.uid == uid;
          }
        }
      }
    }

    function validChannelName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    function channelOpen(sid, channelId) {
      let path = /databases/$(database)/documents/societies/$(sid)/channels/$(channelId);
      return exists(path) && get(path).data.archived == false;
    }

    // A new or edited post: text and/or up to 6 photos in the post's own
    // folder; counts start at zero and are kept by Cloud Functions.
    function validPost(sid, postId, d) {
      return d.keys().hasOnly(['authorUid', 'authorName', 'authorUnit', 'text', 'photos',
                               'mentions', 'pinned', 'reactionCounts', 'commentCount',
                               'createdAt', 'editedAt'])
        && d.authorUid == request.auth.uid
        && d.get('authorName', '') is string && d.get('authorName', '').size() <= 60
        && d.get('authorUnit', '') is string && d.get('authorUnit', '').size() <= 20
        && d.text is string && d.text.size() <= 2000
        && d.photos is list && d.photos.size() <= 6
        && (d.text.size() > 0 || d.photos.size() > 0)
        && (d.photos.size() == 0
            || d.photos[0].path.matches('societies/' + sid + '/posts/' + postId + '/.+'))
        && (d.photos.size() < 2
            || d.photos[1].path.matches('societies/' + sid + '/posts/' + postId + '/.+'))
        && (d.photos.size() < 3
            || d.photos[2].path.matches('societies/' + sid + '/posts/' + postId + '/.+'))
        && (d.photos.size() < 4
            || d.photos[3].path.matches('societies/' + sid + '/posts/' + postId + '/.+'))
        && (d.photos.size() < 5
            || d.photos[4].path.matches('societies/' + sid + '/posts/' + postId + '/.+'))
        && (d.photos.size() < 6
            || d.photos[5].path.matches('societies/' + sid + '/posts/' + postId + '/.+'))
        && d.mentions is list && d.mentions.size() <= 20
        && d.pinned == false
        && d.reactionCounts == {}
        && d.commentCount == 0;
    }

    function validComment(d) {
      return d.keys().hasOnly(['authorUid', 'authorName', 'text', 'replyTo', 'mentions',
                               'reactionCounts', 'createdAt', 'editedAt'])
        && d.authorUid == request.auth.uid
        && d.get('authorName', '') is string && d.get('authorName', '').size() <= 60
        && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
        && (d.replyTo == null || d.replyTo is string)
        && d.mentions is list && d.mentions.size() <= 20
        && d.reactionCounts == {};
    }

    function validReaction(d) {
      return d.keys().hasOnly(['emoji', 'createdAt'])
        && d.emoji in ['👍', '❤️', '😂', '😮', '😢', '🙏']
        && d.createdAt == request.time;
    }

    // Lets people list their own memberships and requests across
    // societies (a collection group query on members where uid == theirs).
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    function validNotice(sid, noticeId, d) {
      return d.keys().hasOnly(['title', 'body', 'pinned', 'expiresAt', 'attachment',
                               'authorUid', 'authorName', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.body is string && d.body.size() <= 2000
        && d.pinned is bool
        && (d.get('expiresAt', null) == null || d.expiresAt is timestamp)
        && d.get('authorName', '') is string && d.get('authorName', '').size() <= 60
        && (d.get('attachment', null) == null || (d.attachment is map
            && d.attachment.keys().hasOnly(['path', 'name', 'contentType'])
            && d.attachment.path.matches('societies/' + sid + '/notices/' + noticeId + '/.+')
            && d.attachment.name is string && d.attachment.name.size() <= 200
            && d.attachment.contentType in ['application/pdf', 'image/jpeg']));
    }

    // A request to become a society's first admin. The applicant uploads
    // a photo ID and proof of office, then creates the claim; a platform
    // admin decides it with the decideClaim function, which also writes
    // the audit trail.
    match /societyClaims/{claimId} {
      allow read: if (signedIn() && resource.data.applicantUid == request.auth.uid)
        || isPlatformAdmin();
      allow create: if fullAccount() && validClaim(claimId, request.resource.data);
      allow update, delete: if false;

      match /audit/{eventId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }
    }

    function validClaim(claimId, d) {
      let prefix = 'societyClaims/' + request.auth.uid + '/' + claimId + '/';
      return d.keys().hasOnly(['applicantUid', 'applicantName', 'applicantEmail', 'society',
                               'position', 'hoa', 'files', 'status', 'previousClaimId', 'createdAt'])
        && d.applicantUid == request.auth.uid
        && d.get('applicantName', '') is string && d.get('applicantName', '').size() <= 100
        && d.get('applicantEmail', '') == request.auth.token.get('email', '')
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.get('previousClaimId', '') is string
        && d.position in ['president', 'secretary', 'board_member', 'manager']
        && d.society is map
        && d.society.keys().hasOnly(['name', 'address', 'lat', 'lng', 'geohash',
                                     'municipalityId', 'municipalityName', 'units'])
        && d.society.name is string && d.society.name.size() >= 2 && d.society.name.size() <= 100
        && d.society.address is string && d.society.address.size() <= 200
        && inCounty(d.society)
        && d.society.geohash is string && d.society.geohash.size() == 9
        && d.society.municipalityId is string && d.society.municipalityId.size() > 0
        && d.society.municipalityName is string
        && d.society.units is int && d.society.units >= 2 && d.society.units <= 5000
        && d.hoa is map
        && d.hoa.keys().hasOnly(['company', 'website', 'accountUrl'])
        && d.hoa.company is string && d.hoa.company.size() <= 100
        && httpsUrl(d.hoa.website) && httpsUrl(d.hoa.accountUrl)
        && d.files is map
        && d.files.keys().hasOnly(['id', 'proof'])
        && d.files.id is string && d.files.id.matches(prefix + 'id[.](jpg|png|pdf)')
        && d.files.proof is string && d.files.proof.matches(prefix + 'proof[.](jpg|png|pdf)');
    }

    // Invite code to society lookup, used only by the joinWithCode function.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // ---- Burghood service requests and providers (Phase 3) ----

    // Provider profiles: the owner applies and edits their details; a
    // platform admin approves (decideProvider), records background checks
    // and suspends. Ratings, rank and keywords are kept by Cloud Functions.
    match /providers/{providerId} {
      allow read: if (fullAccount() && resource.data.status == 'approved')
        || (signedIn() && request.auth.uid == providerId)
        || isPlatformAdmin();
      allow create: if fullAccount() && request.auth.uid == providerId
        && validProvider(providerId, request.resource.data)
        && request.resource.data.status == 'applied'
        && !request.resource.data.keys().hasAny(['keywords', 'ratingAvg', 'ratingCount',
             'rankScore', 'backgroundCheck', 'decidedBy', 'decidedAt', 'rejectReason', 'liveAt',
             'listing', 'paymentRequest'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Details any time; a rejected application can be sent again.
      allow update: if fullAccount() && request.auth.uid == providerId
        && validProvider(providerId, request.resource.data)
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['businessName', 'description', 'phone', 'serviceArea',
                         'portfolio', 'updatedAt']))
            || (resource.data.status == 'rejected'
                && request.resource.data.status == 'applied'
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['businessName', 'description', 'phone', 'serviceArea',
                               'portfolio', 'categories', 'documents', 'status',
                               'updatedAt'])));
      allow delete: if false;

      // One review per confirmed job; the doc id is the request's id.
      match /reviews/{requestId} {
        allow read: if fullAccount() || isPlatformAdmin();
        allow create: if fullAccount() && validReview(providerId, requestId);
        allow update: if signedIn() && request.auth.uid == providerId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reply', 'replyAt'])
          && request.resource.data.reply is string
          && request.resource.data.reply.size() <= 500
          && request.resource.data.replyAt == request.time;
        allow delete: if false;
      }

      // Decisions, checks and document views, written by Cloud Functions.
      match /audit/{entryId} {
        allow read: if isPlatformAdmin();
        allow write: if false;
      }
    }

    function validProvider(uid, d) {
      let docs = 'providerDocs/' + uid + '/';
      return d.keys().hasOnly(['ownerUid', 'businessName', 'description', 'phone',
                               'categories', 'serviceArea', 'documents', 'portfolio',
                               'status', 'createdAt', 'updatedAt',
                               'keywords', 'ratingAvg', 'ratingCount', 'rankScore',
                               'backgroundCheck', 'decidedBy', 'decidedAt', 'rejectReason',
                               'liveAt', 'listing', 'paymentRequest'])
        && d.ownerUid == uid
        && d.businessName is string && d.businessName.size() >= 2 && d.businessName.size() <= 80
        && d.description is string && d.description.size() <= 1000
        && d.get('phone', '') is string && d.get('phone', '').size() <= 20
        && d.categories is list && d.categories.size() >= 1 && d.categories.size() <= 10
        && d.serviceArea is map
        && d.serviceArea.keys().hasOnly(['lat', 'lng', 'geohash', 'radiusMiles', 'label'])
        && inCounty(d.serviceArea)
        && d.serviceArea.geohash is string && d.serviceArea.geohash.size() == 9
        && d.serviceArea.radiusMiles is number
        && d.serviceArea.radiusMiles >= 1 && d.serviceArea.radiusMiles <= 25
        && d.documents is map
        && d.documents.keys().hasOnly(['license', 'insurance', 'background'])
        && (!('license' in d.documents) || d.documents.license.matches(docs + 'license[.](jpg|png|pdf)'))
        && (!('insurance' in d.documents) || d.documents.insurance.matches(docs + 'insurance[.](jpg|png|pdf)'))
        && (!('background' in d.documents) || d.documents.background.matches(docs + 'background[.](jpg|png|pdf)'))
        && d.get('portfolio', []) is list && d.get('portfolio', []).size() <= 12
        && d.status in ['applied', 'approved', 'awaiting_fee', 'rejected', 'suspended'];
    }

    function validReview(providerId, requestId) {
      let job = get(/databases/$(database)/documents/serviceRequests/$(requestId)).data;
      let d = request.resource.data;
      return job.posterUid == request.auth.uid
        && job.providerId == providerId
        && job.status == 'confirmed'
        && d.keys().hasOnly(['stars', 'comment', 'authorUid', 'authorName', 'category', 'createdAt'])
        && d.authorUid == request.auth.uid
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.comment is string && d.comment.size() <= 500
        && d.get('authorName', '') is string && d.get('authorName', '').size() <= 60
        && d.get('category', '') == job.category
        && d.createdAt == request.time;
    }

    // Service requests: a resident posts one for their home or (as a
    // member) for their society's common areas. The poster and the
    // assigned provider each move it through only their own steps; a
    // society admin assigns providers for common-area requests. Status
    // history is written by Cloud Functions.
    match /serviceRequests/{requestId} {
      allow read: if (signedIn() && (resource.data.posterUid == request.auth.uid
            || resource.data.get('providerId', null) == request.auth.uid))
        || (resource.data.scope == 'common' && isSocietyAdmin(resource.data.societyId))
        || isPlatformAdmin();
      allow create: if fullAccount() && validNewRequest(requestId, request.resource.data);
      allow update: if signedIn() && request.resource.data.updatedAt == request.time
        && (posterStep() || providerStep() || societyAssigns());
      allow delete: if false;

      match /events/{eventId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.posterUid == request.auth.uid
              || get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.get('providerId', null) == request.auth.uid
              || isPlatformAdmin());
        allow write: if false;
      }
    }

    function changes(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function moves(from, to) {
      return resource.data.status in from && request.resource.data.status == to;
    }

    function approvedProvider(pid) {
      return pid is string
        && get(/databases/$(database)/documents/providers/$(pid)).data.status == 'approved';
    }

    // The poster: edit while open, pick a provider, cancel, confirm or
    // send it back as not fixed.
    function posterStep() {
      let d = request.resource.data;
      return resource.data.posterUid == request.auth.uid && (
        (resource.data.status in ['posted', 'assigned']
          && changes(['title', 'description', 'details', 'updatedAt'])
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
          && d.description is string && d.description.size() <= 2000)
        || (moves(['posted', 'declined'], 'assigned')
          && changes(['providerId', 'status', 'updatedAt'])
          && approvedProvider(d.providerId) && d.providerId != request.auth.uid)
        || (moves(['posted', 'assigned', 'declined'], 'cancelled')
          && changes(['status', 'updatedAt']))
        || (moves(['completed'], 'confirmed')
          && changes(['status', 'confirmedAt', 'updatedAt'])
          && d.confirmedAt == request.time)
        || (moves(['completed'], 'not_fixed')
          && changes(['status', 'notFixedNote', 'updatedAt'])
          && d.notFixedNote is string && d.notFixedNote.size() <= 500));
    }

    // The assigned provider: accept or decline, start, and complete with a
    // note and photos or a short video.
    function providerStep() {
      let d = request.resource.data;
      return resource.data.get('providerId', null) == request.auth.uid && (
        (moves(['assigned'], 'accepted') && changes(['status', 'updatedAt']))
        || (moves(['assigned'], 'declined')
          && changes(['status', 'declineReason', 'updatedAt'])
          && d.declineReason is string && d.declineReason.size() <= 300)
        || (moves(['accepted', 'not_fixed'], 'in_progress') && changes(['status', 'updatedAt']))
        || (moves(['accepted', 'in_progress', 'not_fixed'], 'completed')
          && changes(['status', 'completion', 'completedAt', 'updatedAt'])
          && d.completedAt == request.time
          && validCompletion(d.completion)));
    }

    function validCompletion(c) {
      let folder = 'serviceRequests/' + request.resource.id + '/completion/';
      return c is map
        && c.keys().hasOnly(['note', 'photos', 'video'])
        && c.note is string && c.note.size() <= 1000
        && c.photos is list && c.photos.size() <= 6
        && (c.photos.size() == 0 || c.photos[0].path.matches(folder + '.+'))
        && (c.get('video', null) == null || (c.video is map && c.video.path.matches(folder + '.+')));
    }

    // A society admin picks the provider for a common-area request.
    function societyAssigns() {
      let d = request.resource.data;
      return resource.data.scope == 'common'
        && isSocietyAdmin(resource.data.societyId)
        && moves(['posted', 'declined'], 'assigned')
        && changes(['providerId', 'status', 'updatedAt'])
        && approvedProvider(d.providerId);
    }

    function validNewRequest(rid, d) {
      return d.keys().hasOnly(['posterUid', 'posterName', 'scope', 'societyId', 'title',
                               'description', 'category', 'group', 'details', 'photos',
                               'location', 'providerId', 'status', 'createdAt', 'updatedAt'])
        && d.posterUid == request.auth.uid
        && d.get('posterName', '') is string && d.get('posterName', '').size() <= 60
        && d.scope in ['home', 'common']
        && (d.scope == 'home' || (d.societyId is string && isMember(d.societyId)))
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
        && d.description is string && d.description.size() <= 2000
        && d.category is string && d.category.size() <= 40
        && d.group is string && d.group.size() <= 40
        && d.details is map && d.details.size() <= 12
        && d.photos is list && d.photos.size() <= 6
        && (d.photos.size() == 0 || d.photos[0].path.matches('serviceRequests/' + rid + '/.+'))
        && (d.get('location', null) == null || (d.location is map && inCounty(d.location)))
        && ((d.get('providerId', null) == null && d.status == 'posted')
            || (d.status == 'assigned' && approvedProvider(d.providerId)
                && d.providerId != request.auth.uid))
        && d.createdAt == request.time && d.updatedAt == request.time;
    }

    // Sponsored listings (Phase 4). Platform admins schedule them; Cloud
    // Functions set `paid` and `active` from the ledger and the date, and
    // accounts see only active ones.
    match /sponsorships/{sponsorshipId} {
      allow read: if isPlatformAdmin()
        || (fullAccount() && resource.data.active == true);
      allow create: if isPlatformAdmin() && validSponsorship(request.resource.data)
        && !request.resource.data.keys().hasAny(['paid', 'active'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isPlatformAdmin() && validSponsorship(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['categories', 'area', 'startDate', 'endDate', 'priceUsd', 'note']);
      allow delete: if isPlatformAdmin() && resource.data.get('paid', false) == false;
    }

    function isDate(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function validSponsorship(d) {
      return d.keys().hasOnly(['providerId', 'businessName', 'categories', 'area', 'startDate',
                               'endDate', 'priceUsd', 'note', 'createdBy', 'createdAt', 'paid', 'active'])
        && d.providerId is string
        && exists(/databases/$(database)/documents/providers/$(d.providerId))
        && d.businessName is string && d.businessName.size() <= 80
        && d.categories is list && d.categories.size() >= 1 && d.categories.size() <= 10
        && d.area is map && d.area.keys().hasOnly(['lat', 'lng', 'radiusMiles', 'label'])
        && d.area.lat is number && d.area.lng is number
        && d.area.radiusMiles is number && d.area.radiusMiles >= 1 && d.area.radiusMiles <= 25
        && isDate(d.startDate) && isDate(d.endDate) && d.startDate <= d.endDate
        && d.get('priceUsd', 0) is number && d.get('priceUsd', 0) >= 0
        && d.get('note', '') is string && d.get('note', '').size() <= 300;
    }

    // Settings for fees and sponsorships, until the amounts are decided.
    match /config/monetisation {
      allow read: if signedIn();
      allow write: if isPlatformAdmin()
        && request.resource.data.keys().hasOnly(['listingFeeUsd', 'listingMonths',
             'sponsorshipWeeklyUsd', 'maxSponsored', 'reminderDays', 'updatedBy', 'updatedAt',
             'emulatorFlag', 'paymentInstructions', 'payLink'])
        && request.resource.data.get('paymentInstructions', '') is string
        && request.resource.data.get('paymentInstructions', '').size() <= 1000
        && request.resource.data.get('payLink', '') is string
        && (request.resource.data.get('payLink', '') == ''
            || (request.resource.data.payLink.matches('https://[^ ]+')
                && request.resource.data.payLink.size() <= 500))
        // The emulator-only flag stays as tests set it.
        && (resource == null
            ? !('emulatorFlag' in request.resource.data)
            : request.resource.data.get('emulatorFlag', null) == resource.data.get('emulatorFlag', null))
        && request.resource.data.listingFeeUsd is number && request.resource.data.listingFeeUsd >= 0
        && request.resource.data.listingMonths is int
        && request.resource.data.listingMonths >= 1 && request.resource.data.listingMonths <= 36
        && request.resource.data.sponsorshipWeeklyUsd is number && request.resource.data.sponsorshipWeeklyUsd >= 0
        && request.resource.data.maxSponsored is int
        && request.resource.data.maxSponsored >= 0 && request.resource.data.maxSponsored <= 2
        && request.resource.data.reminderDays is int
        && request.resource.data.reminderDays >= 0 && request.resource.data.reminderDays <= 60
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Append-only ledger (Phase 4): even admins can't edit or delete.
    // A reversing entry undoes one payment, once: its id is `rev_` plus the
    // original's, and it repeats the original's type, kind, amount and links.
    match /payments/{paymentId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin() && validPayment(request.resource.data)
        && (request.resource.data.get('reversalOf', null) == null
            ? !paymentId.matches('rev_.*') && request.resource.data.get('reason', '') == ''
            : validReversal(paymentId, request.resource.data));
      allow update, delete: if false;
    }

    function validPayment(d) {
      return d.keys().hasOnly(['type', 'kind', 'amountCents', 'currency', 'date', 'method',
                               'reference', 'purpose', 'party', 'providerId', 'sponsorshipId',
                               'periodMonths', 'recordedBy', 'recordedByEmail', 'recordedAt',
                               'reversalOf', 'reason'])
        && d.type in ['income', 'expense']
        && d.kind in ['listing_fee', 'sponsorship', 'other']
        && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 10000000
        && d.currency == 'USD'
        && isDate(d.date)
        && d.method in ['cash', 'check', 'bank_transfer', 'card', 'online', 'other']
        && d.get('reference', '') is string && d.get('reference', '').size() <= 100
        && d.purpose is string && d.purpose.size() >= 1 && d.purpose.size() <= 300
        && d.party is string && d.party.size() >= 1 && d.party.size() <= 120
        && (d.kind != 'listing_fee' || (d.type == 'income' && d.providerId is string
              && d.periodMonths is int && d.periodMonths >= 1 && d.periodMonths <= 36))
        && (d.kind != 'sponsorship' || (d.type == 'income' && d.sponsorshipId is string))
        && d.recordedBy == request.auth.uid
        && d.recordedByEmail == request.auth.token.get('email', '')
        && d.recordedAt == request.time;
    }

    function validReversal(paymentId, d) {
      let o = get(/databases/$(database)/documents/payments/$(d.reversalOf)).data;
      return paymentId == 'rev_' + d.reversalOf
        && o.get('reversalOf', null) == null
        && d.type == o.type && d.kind == o.kind && d.amountCents == o.amountCents
        && d.get('providerId', null) == o.get('providerId', null)
        && d.get('sponsorshipId', null) == o.get('sponsorshipId', null)
        && d.get('periodMonths', null) == o.get('periodMonths', null)
        && d.reason is string && d.reason.size() >= 1 && d.reason.size() <= 300;
    }
  }
}
